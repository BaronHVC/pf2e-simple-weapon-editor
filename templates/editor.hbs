<div class="swe-body">

  <header class="swe-header">
    <img src="{{img}}" alt="" />
    <input type="text" name="name" value="{{data.name}}" class="swe-name" />
    <div class="swe-badges">
      <label>{{localize "SWE.Level"}}
        <input type="number" name="level" value="{{data.level}}" min="0" max="30" step="1" />
      </label>
      <label title="{{localize 'SWE.TotalPriceHint'}}">{{localize "SWE.PriceGp"}}
        <input type="number" name="totalGp" value="{{totalGp}}" min="0" step="1" placeholder="auto" />
      </label>
      {{#if runesGp}}
      <span class="swe-derived" title="{{localize 'SWE.RunesPriceHint'}}"><i class="fa-solid fa-coins"></i> {{localize "SWE.Runes"}}: {{runesGp}} gp</span>
      {{/if}}
    </div>
  </header>

  <nav class="swe-tabs">
    <a data-action="sweTab" data-tab="damage" class="{{#if (sweEq activeTab 'damage')}}active{{/if}}"><i class="fa-solid fa-droplet"></i> {{localize "SWE.Damage"}}</a>
    <a data-action="sweTab" data-tab="runes" class="{{#if (sweEq activeTab 'runes')}}active{{/if}}"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "SWE.Runes"}}</a>
    <a data-action="sweTab" data-tab="traits" class="{{#if (sweEq activeTab 'traits')}}active{{/if}}"><i class="fa-solid fa-tags"></i> {{localize "SWE.Traits"}}</a>
    <a data-action="sweTab" data-tab="conds" class="{{#if (sweEq activeTab 'conds')}}active{{/if}}"><i class="fa-solid fa-users"></i> {{localize "SWE.TabConds"}}</a>
  </nav>

  <fieldset class="swe-section swe-tabpanel{{#if (sweEq activeTab 'damage')}} active{{/if}}">
    <legend><i class="fa-solid fa-droplet"></i> {{localize "SWE.Damage"}}</legend>

    <div class="swe-block">
      <div class="swe-block-head">
        <span class="swe-block-title">{{localize "SWE.Base"}}</span>
        {{#if baseNote}}
        <span class="swe-block-note">{{localize "SWE.WithStriking"}} <b>{{baseNote}}</b></span>
        {{/if}}
        {{#if strikingIgnored}}
        <span class="swe-block-note">{{localize "SWE.StrikingIgnored"}}</span>
        {{/if}}
      </div>
      <div class="swe-row">
        <input type="number" name="damage.dice" value="{{data.damage.dice}}" min="1" max="12" step="1" class="swe-narrow" />
        <select name="damage.die">
          {{#each dies}}
          <option value="{{this}}" {{#if (sweEq this ../data.damage.die)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <i class="swe-dmgicon fa-solid {{baseIcon}}" style="color: {{baseDot}}"></i>
        <select name="damage.damageType">
          {{#each damageTypes}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../data.damage.damageType)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="swe-row">
        <span class="swe-tag">{{localize "SWE.Splash"}}</span>
        <input type="number" name="splash" value="{{data.splash}}" min="0" max="99" step="1" class="swe-narrow" />
        <span class="swe-splash-hint">{{localize "SWE.SplashHint"}}</span>
      </div>
    </div>

    <div class="swe-block swe-block-extra">
      <div class="swe-block-head">
        <span class="swe-block-title swe-title-extra">{{localize "SWE.ExtrasHead"}}</span>
      </div>
      {{#each extrasIndexed}}
      <div class="swe-row">
        <input type="number" name="extras.{{this.index}}.value" value="{{this.value}}" min="1" max="99" step="1" class="swe-narrow" />
        <select name="extras.{{this.index}}.die">
          <option value="" {{#unless this.die}}selected{{/unless}}>{{localize "SWE.Fixed"}}</option>
          {{#each ../dies}}
          <option value="{{this}}" {{#if (sweEq this ../this.die)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <i class="swe-dmgicon fa-solid {{this.icon}}" style="color: {{this.dot}}"></i>
        <select name="extras.{{this.index}}.type">
          {{#each ../damageTypes}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../this.type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <select name="extras.{{this.index}}.category" class="swe-cat" title="{{localize 'SWE.SplashHint'}}">
          <option value="" {{#unless this.category}}selected{{/unless}}>&mdash;</option>
          <option value="splash" {{#if (sweEq this.category 'splash')}}selected{{/if}}>{{localize "SWE.Splash"}}</option>
        </select>
        <input type="text" name="extras.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" class="swe-src" />
        <a class="swe-rowdel" data-action="sweRemoveDamage" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/each}}
      {{#each dmgCondRows}}
      <div class="swe-locked-row">
        <i class="fa-solid fa-lock swe-lock" title="{{localize 'SWE.EditInConds'}}"></i>
        <i class="swe-dmgicon fa-solid {{this.icon}}" style="color: {{this.dot}}"></i>
        <span class="swe-locked-amount" style="color: {{this.dot}}">+{{this.amount}} {{this.typeLabel}}</span>
        <span class="swe-locked-reason">{{localize "SWE.FromCond"}} {{this.reason}}</span>
        <a class="swe-rowdel" data-action="sweRemoveCond" data-index="{{this.condIndex}}" title="{{localize 'SWE.RemoveCond'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/each}}
      <button type="button" data-action="sweAddDamage" class="swe-ghostbtn swe-ghost-extra"><i class="fa-solid fa-plus"></i> {{localize "SWE.Extra"}}</button>
    </div>

    <div class="swe-block swe-block-pers">
      <div class="swe-block-head">
        <span class="swe-block-title swe-title-pers"><i class="fa-solid fa-droplet"></i> {{localize "SWE.Persistent"}}</span>
        <span class="swe-block-note">{{localize "SWE.PersExplain"}}</span>
      </div>
      {{#each persIndexed}}
      <div class="swe-row">
        <input type="number" name="pers.{{this.index}}.value" value="{{this.value}}" min="1" max="99" step="1" class="swe-narrow" />
        <select name="pers.{{this.index}}.die">
          <option value="" {{#unless this.die}}selected{{/unless}}>{{localize "SWE.Fixed"}}</option>
          {{#each ../dies}}
          <option value="{{this}}" {{#if (sweEq this ../this.die)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <i class="swe-dmgicon fa-solid {{this.icon}}" style="color: {{this.dot}}"></i>
        <select name="pers.{{this.index}}.type">
          {{#each ../damageTypes}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../this.type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <input type="text" name="pers.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" class="swe-src" />
        <a class="swe-rowdel" data-action="sweRemovePersistent" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/each}}
      <button type="button" data-action="sweAddPersistent" class="swe-ghostbtn swe-ghost-pers"><i class="fa-solid fa-plus"></i> {{localize "SWE.Persistent"}}</button>
    </div>

    <div class="swe-previewbar">
      <span class="swe-previewbar-label">{{localize "SWE.Preview"}}:</span>
      {{#each previewParts}}<span style="color: {{this.color}}">{{this.text}}</span>{{/each}}
    </div>
    {{#if critPreview}}
    <p class="swe-preview swe-crit"><i class="fa-solid fa-burst"></i> {{localize "SWE.OnCrit"}}: <code>{{critPreview}}</code></p>
    {{/if}}
  </fieldset>

  <fieldset class="swe-section swe-tabpanel{{#if (sweEq activeTab 'runes')}} active{{/if}}">
    <legend><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "SWE.Runes"}}</legend>

    <div class="swe-grid2">
      <label>{{localize "SWE.Potency"}}
        <select name="runes.potency">
          {{#each potencyOptions}}
          <option value="{{this}}" {{#if (sweEq this ../data.runes.potency)}}selected{{/if}}>{{#if this}}+{{this}}{{else}}—{{/if}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "SWE.Striking"}}
        <select name="runes.striking">
          {{#each strikingOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../data.runes.striking)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
    </div>

    <div class="swe-runes-meta">
      <span class="swe-block-title">{{localize "SWE.PropertyRunes"}}</span>
      <span class="{{#if overLimit}}swe-meta-over{{else}}swe-meta-ok{{/if}}">{{propCount}}/{{potency}}</span>
      {{#if runesGp}}<span class="swe-meta-gp">{{runesGp}} gp</span>{{/if}}
    </div>

    {{#each runesResolved}}
    <div class="swe-rune-card{{#if this.over}} over{{/if}}{{#if this.selected}} open{{/if}}">
      <div class="swe-rune-row">
        <span class="swe-rune-name">{{this.label}}</span>
        {{#if this.level}}<span class="swe-badge-lv">{{localize "SWE.LevelShort"}} {{this.level}}</span>{{/if}}
        {{#if this.over}}
        <span class="swe-rune-over">{{localize "SWE.OverSlot"}}</span>
        {{else}}
        {{#if this.price}}<span class="swe-rune-price">{{this.price}} gp</span>{{/if}}
        {{/if}}
        <span class="swe-rune-acts">
          <a data-action="sweShowRune" data-slug="{{this.slug}}" title="{{localize 'SWE.ShowRune'}}"><i class="fa-solid fa-circle-info"></i></a>
          <a data-action="sweRemoveRune" data-slug="{{this.slug}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
        </span>
      </div>
      {{#if this.selected}}
      <div class="swe-rune-desc">
        {{#if this.descHTML}}{{{this.descHTML}}}{{else}}<p class="swe-muted">{{localize "SWE.NoRuneDesc"}}</p>{{/if}}
      </div>
      {{/if}}
    </div>
    {{/each}}

    <div class="swe-row">
      <input type="text" name="runeToAdd" list="swe-dl-rune" class="swe-search" placeholder="{{localize 'SWE.RuneSearchPh'}}" autocomplete="off" spellcheck="false" />
      <button type="button" data-action="sweAddRune"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddRune"}}</button>
    </div>

    {{#if overLimit}}
    <p class="swe-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SWE.OverLimit"}} ({{propCount}}/{{potency}})</p>
    <label class="swe-check">
      <input type="checkbox" name="freeMode" {{#if data.freeMode}}checked{{/if}} />
      {{localize "SWE.FreeMode"}}
    </label>
    {{/if}}
  </fieldset>

  <fieldset class="swe-section swe-tabpanel{{#if (sweEq activeTab 'traits')}} active{{/if}}">
    <legend><i class="fa-solid fa-tags"></i> {{localize "SWE.Traits"}}</legend>
    <div class="swe-chiplist">
      {{#each traitsResolved}}
      <span class="swe-chip">{{this.label}}
        <a data-action="sweRemoveTrait" data-slug="{{this.slug}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
      </span>
      {{/each}}
    </div>
    <div class="swe-row">
      <input type="text" name="traitToAdd" list="swe-dl-trait" class="swe-search" placeholder="{{localize 'SWE.TraitSearchPh'}}" autocomplete="off" spellcheck="false" />
      <button type="button" data-action="sweAddTrait"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddTrait"}}</button>
    </div>
    {{#if freqTraits.length}}
    <div class="swe-freq">
      <span class="swe-freq-label">{{localize "SWE.Frequent"}}</span>
      <div class="swe-chiplist">
        {{#each freqTraits}}
        <a class="swe-ghostchip" data-action="sweQuickTrait" data-slug="{{this.value}}"><i class="fa-solid fa-plus"></i> {{this.label}}</a>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </fieldset>

  <fieldset class="swe-section swe-tabpanel{{#if (sweEq activeTab 'conds')}} active{{/if}}">
    <legend><i class="fa-solid fa-users"></i> {{localize "SWE.Conditionals"}}</legend>
    <p class="swe-hint">{{localize "SWE.CondHint"}}</p>

    {{#each condIndexed}}
    <div class="swe-card swe-kind-{{this.kind}}">
      <div class="swe-card-head"{{#if this.isDamage}} style="background: {{this.headBg}}"{{/if}}>
        <span class="swe-fx-icon"{{#if this.isDamage}} style="color: {{this.dot}}; background: {{this.iconBg}}; border-color: {{this.iconBorder}}"{{/if}}>{{#if this.isDamage}}<i class="fa-solid {{this.icon}}"></i>{{else}}<i class="fa-solid fa-heart"></i>{{/if}}</span>
        <select name="conds.{{this.index}}.effect" class="swe-fx-select">
          {{#each ../effectOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../effect)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{#if this.isDamage}}
        <select name="conds.{{this.index}}.type">
          {{#each ../damageTypes}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{/if}}
        <span class="swe-card-amount">
          <input type="number" name="conds.{{this.index}}.value" value="{{this.value}}" min="1" max="99" step="1" class="swe-narrow" />
          <select name="conds.{{this.index}}.die">
            <option value="" {{#unless this.die}}selected{{/unless}}>{{localize "SWE.Fixed"}}</option>
            {{#each ../dies}}
            <option value="{{this}}" {{#if (sweEq this ../die)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </span>
        <a class="swe-rowdel" data-action="sweRemoveCond" data-index="{{this.index}}" title="{{localize 'SWE.RemoveCond'}}"><i class="fa-solid fa-trash"></i></a>
      </div>

      <div class="swe-card-body">
        <span class="swe-card-when">{{localize "SWE.CondWhen"}}</span>
        {{#each this.criteria}}
        <div class="swe-cond-when">
          <span class="swe-tag">{{#if this.first}}{{localize "SWE.CondIf"}}{{else}}{{localize "SWE.CondAnd"}}{{/if}}</span>
          <select name="conds.{{this.condIndex}}.criteria.{{this.index}}.filter">
            {{#each ../../filterOptions}}
            <option value="{{this.value}}" {{#if (sweEq this.value ../filter)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          <input type="text" name="conds.{{this.condIndex}}.criteria.{{this.index}}.slugInput" value="{{this.display}}" list="swe-dl-{{this.filter}}" class="swe-cond-target" placeholder="{{localize 'SWE.CondSearchPh'}}" autocomplete="off" spellcheck="false" />
          <a data-action="sweRemoveCrit" data-cond="{{this.condIndex}}" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
        </div>
        {{#if this.unknown}}
        <p class="swe-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SWE.CondUnknown"}}: <code>{{this.slug}}</code></p>
        {{/if}}
        {{/each}}
        <a class="swe-ghostchip" data-action="sweAddCrit" data-cond="{{this.index}}"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddCriterion"}}</a>
      </div>

      <div class="swe-cond-note">
        <input type="text" name="conds.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" />
      </div>
    </div>
    {{/each}}

    <div class="swe-row">
      <button type="button" data-action="sweAddCond"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddCond"}}</button>
    </div>

    {{#each datalists}}
    <datalist id="swe-dl-{{this.key}}">
      {{#each this.options}}<option value="{{this.label}}"></option>{{/each}}
    </datalist>
    {{/each}}
    <datalist id="swe-dl-feat"></datalist>
  </fieldset>

  <footer class="swe-footer">
    <button type="button" data-action="sweRevert"><i class="fa-solid fa-rotate-left"></i> {{localize "SWE.Revert"}}</button>
    <button type="submit" class="swe-save"><i class="fa-solid fa-floppy-disk"></i> {{localize "SWE.Save"}}</button>
  </footer>

</div>
