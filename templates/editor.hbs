<div class="swe-body">

  <header class="swe-header">
    <img src="{{img}}" alt="" />
    <input type="text" name="name" value="{{data.name}}" class="swe-name" />
    <div class="swe-badges">
      <label>{{localize "SWE.Level"}}
        <input type="number" name="level" value="{{data.level}}" min="0" max="30" step="1" />
      </label>
      <label title="{{localize 'SWE.TotalPriceHint'}}">{{localize "SWE.PriceGp"}}
        <input type="number" name="totalGp" value="{{totalGp}}" min="0" step="1" placeholder="auto" />
      </label>
      {{#if runesGp}}
      <span class="swe-derived" title="{{localize 'SWE.RunesPriceHint'}}"><i class="fa-solid fa-coins"></i> {{localize "SWE.Runes"}}: {{runesGp}} gp</span>
      {{/if}}
    </div>
  </header>

  <fieldset class="swe-section">
    <legend><i class="fa-solid fa-droplet"></i> {{localize "SWE.Damage"}}</legend>

    <div class="swe-row">
      <span class="swe-tag">{{localize "SWE.Base"}}</span>
      <input type="number" name="damage.dice" value="{{data.damage.dice}}" min="1" max="12" step="1" class="swe-narrow" />
      <select name="damage.die">
        {{#each dies}}
        <option value="{{this}}" {{#if (sweEq this ../data.damage.die)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
      <select name="damage.damageType">
        {{#each damageTypes}}
        <option value="{{this.value}}" {{#if (sweEq this.value ../data.damage.damageType)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    {{#each extrasIndexed}}
    <div class="swe-row">
      <span class="swe-tag">{{localize "SWE.Extra"}}</span>
      <input type="number" name="extras.{{this.index}}.value" value="{{this.value}}" min="1" max="99" step="1" class="swe-narrow" />
      <select name="extras.{{this.index}}.die">
        <option value="" {{#unless this.die}}selected{{/unless}}>{{localize "SWE.Fixed"}}</option>
        {{#each ../dies}}
        <option value="{{this}}" {{#if (sweEq this ../this.die)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
      <select name="extras.{{this.index}}.type">
        {{#each ../damageTypes}}
        <option value="{{this.value}}" {{#if (sweEq this.value ../this.type)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
      <input type="text" name="extras.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" class="swe-src" />
      <a class="swe-rowdel" data-action="sweRemoveDamage" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-trash"></i></a>
    </div>
    {{/each}}

    <div class="swe-row">
      <button type="button" data-action="sweAddDamage" class="swe-addbtn"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddDamage"}}</button>
    </div>

    <div class="swe-persistent">
      <p class="swe-subhead"><i class="fa-solid fa-droplet-slash"></i> {{localize "SWE.Persistent"}}</p>
      {{#each persIndexed}}
      <div class="swe-row">
        <span class="swe-tag">{{localize "SWE.PersTag"}}</span>
        <input type="number" name="pers.{{this.index}}.value" value="{{this.value}}" min="1" max="99" step="1" class="swe-narrow" />
        <select name="pers.{{this.index}}.die">
          <option value="" {{#unless this.die}}selected{{/unless}}>{{localize "SWE.Fixed"}}</option>
          {{#each ../dies}}
          <option value="{{this}}" {{#if (sweEq this ../this.die)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        <select name="pers.{{this.index}}.type">
          {{#each ../damageTypes}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../this.type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <input type="text" name="pers.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" class="swe-src" />
        <a class="swe-rowdel" data-action="sweRemovePersistent" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/each}}
      <div class="swe-row">
        <button type="button" data-action="sweAddPersistent" class="swe-addbtn"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddPersistent"}}</button>
      </div>
    </div>

    <p class="swe-preview">{{localize "SWE.Preview"}}: <code>{{preview}}</code></p>
    {{#if critPreview}}
    <p class="swe-preview swe-crit"><i class="fa-solid fa-burst"></i> {{localize "SWE.OnCrit"}}: <code>{{critPreview}}</code></p>
    {{/if}}
  </fieldset>

  <fieldset class="swe-section">
    <legend><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "SWE.Runes"}}</legend>
    <div class="swe-grid2">
      <label>{{localize "SWE.Potency"}}
        <select name="runes.potency">
          {{#each potencyOptions}}
          <option value="{{this}}" {{#if (sweEq this ../data.runes.potency)}}selected{{/if}}>{{#if this}}+{{this}}{{else}}—{{/if}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "SWE.Striking"}}
        <select name="runes.striking">
          {{#each strikingOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../data.runes.striking)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <div class="swe-chiplist">
      {{#each runesResolved}}
      <span class="swe-chip">
        <a data-action="sweShowRune" data-slug="{{this.slug}}" title="{{localize 'SWE.ShowRune'}}">{{this.label}}</a>
        <a data-action="sweRemoveRune" data-slug="{{this.slug}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
      </span>
      {{/each}}
    </div>
    <div class="swe-row">
      <select name="runeToAdd">
        <option value="">{{localize "SWE.PickRune"}}</option>
        {{#each propertyRunes}}
        <option value="{{this.value}}" {{#if (sweEq this.value ../selectedRune)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="sweAddRune"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddRune"}}</button>
    </div>
    {{#if runeInfo}}
    <div class="swe-runeinfo">
      <p class="swe-runeinfo-head"><i class="fa-solid fa-circle-info"></i> {{runeInfo.label}}{{#if runeInfo.level}} · {{localize "SWE.Level"}} {{runeInfo.level}}{{/if}}{{#if runeInfo.price}} · {{runeInfo.price}} gp{{/if}}</p>
      {{#if runeInfo.descHTML}}
      <div class="swe-runeinfo-desc">{{{runeInfo.descHTML}}}</div>
      {{else}}
      <p class="swe-muted">{{localize "SWE.NoRuneDesc"}}</p>
      {{/if}}
    </div>
    {{/if}}
    {{#if overLimit}}
    <p class="swe-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SWE.OverLimit"}} ({{propCount}}/{{potency}})</p>
    <label class="swe-check">
      <input type="checkbox" name="freeMode" {{#if data.freeMode}}checked{{/if}} />
      {{localize "SWE.FreeMode"}}
    </label>
    {{/if}}
  </fieldset>

  <fieldset class="swe-section">
    <legend><i class="fa-solid fa-tags"></i> {{localize "SWE.Traits"}}</legend>
    <div class="swe-chiplist">
      {{#each traitsResolved}}
      <span class="swe-chip">{{this.label}}
        <a data-action="sweRemoveTrait" data-slug="{{this.slug}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
      </span>
      {{/each}}
    </div>
    <div class="swe-row">
      <select name="traitToAdd">
        <option value="">{{localize "SWE.PickTrait"}}</option>
        {{#each weaponTraits}}
        <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="sweAddTrait"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddTrait"}}</button>
    </div>
  </fieldset>

  <fieldset class="swe-section">
    <legend><i class="fa-solid fa-users"></i> {{localize "SWE.Conditionals"}}</legend>
    <p class="swe-hint">{{localize "SWE.CondHint"}}</p>

    {{#each condIndexed}}
    <div class="swe-cond">
      {{#each this.criteria}}
      <div class="swe-cond-when">
        <span class="swe-tag">{{#if this.first}}{{localize "SWE.CondIf"}}{{else}}{{localize "SWE.CondAnd"}}{{/if}}</span>
        <select name="conds.{{this.condIndex}}.criteria.{{this.index}}.filter">
          {{#each ../../filterOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../filter)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <select name="conds.{{this.condIndex}}.criteria.{{this.index}}.slug" class="swe-cond-target">
          <option value="">{{localize "SWE.CondPickTarget"}}</option>
          {{#each this.options}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../slug)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <a data-action="sweRemoveCrit" data-cond="{{this.condIndex}}" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
      </div>
      {{#if this.unknown}}
      <p class="swe-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SWE.CondUnknown"}}: <code>{{this.slug}}</code></p>
      {{/if}}
      {{/each}}

      <div class="swe-cond-more">
        <a data-action="sweAddCrit" data-cond="{{this.index}}"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddCriterion"}}</a>
      </div>

      <div class="swe-cond-then">
        <span class="swe-tag">{{localize "SWE.CondThen"}}</span>
        <select name="conds.{{this.index}}.effect">
          {{#each ../effectOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../effect)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <input type="number" name="conds.{{this.index}}.value" value="{{this.value}}" min="1" max="99" step="1" class="swe-narrow" />
        <select name="conds.{{this.index}}.die">
          <option value="" {{#unless this.die}}selected{{/unless}}>{{localize "SWE.Fixed"}}</option>
          {{#each ../dies}}
          <option value="{{this}}" {{#if (sweEq this ../die)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
        {{#if this.isDamage}}
        <select name="conds.{{this.index}}.type">
          {{#each ../damageTypes}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{/if}}
      </div>

      <div class="swe-cond-note">
        <input type="text" name="conds.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" />
        <a data-action="sweRemoveCond" data-index="{{this.index}}" title="{{localize 'SWE.RemoveCond'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
    </div>
    {{/each}}

    <div class="swe-row">
      <button type="button" data-action="sweAddCond"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddCond"}}</button>
    </div>
  </fieldset>

  <footer class="swe-footer">
    <button type="button" data-action="sweRevert"><i class="fa-solid fa-rotate-left"></i> {{localize "SWE.Revert"}}</button>
    <button type="submit" class="swe-save"><i class="fa-solid fa-floppy-disk"></i> {{localize "SWE.Save"}}</button>
  </footer>

</div>
