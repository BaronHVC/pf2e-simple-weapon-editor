<div class="swe-body">

  <header class="swe-header">
    <img src="{{img}}" alt="" />
    <input type="text" name="name" value="{{data.name}}" class="swe-name" />
    <div class="swe-badges">
      <label>{{localize "SWE.Level"}}
        <input type="number" name="level" value="{{data.level}}" min="0" max="30" step="1" />
      </label>
      <label title="{{#if priceLocked}}{{localize 'SWE.ArmPriceLockedHint'}}{{else}}{{localize 'SWE.TotalPriceHint'}}{{/if}}">{{localize "SWE.PriceGp"}}
        <input type="number" name="totalGp" value="{{totalGp}}" min="0" step="1" placeholder="auto" {{#if priceLocked}}disabled{{/if}} />
      </label>
      {{#if runesGp}}
      <span class="swe-derived" title="{{localize 'SWE.RunesPriceHint'}}"><i class="fa-solid fa-coins"></i> {{localize "SWE.Runes"}}: {{runesGp}} gp</span>
      {{/if}}
    </div>
  </header>

  <nav class="swe-tabs">
    <a data-action="sweTab" data-tab="defense" class="{{#if (sweEq activeTab 'defense')}}active{{/if}}"><i class="fa-solid fa-shield-halved"></i> {{localize "SWE.ArmTabDefense"}}</a>
    <a data-action="sweTab" data-tab="runes" class="{{#if (sweEq activeTab 'runes')}}active{{/if}}"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "SWE.Runes"}}</a>
    <a data-action="sweTab" data-tab="traits" class="{{#if (sweEq activeTab 'traits')}}active{{/if}}"><i class="fa-solid fa-tags"></i> {{localize "SWE.Traits"}}</a>
  </nav>

  <fieldset class="swe-section swe-tabpanel{{#if (sweEq activeTab 'defense')}} active{{/if}}">
    <legend><i class="fa-solid fa-shield-halved"></i> {{localize "SWE.ArmTabDefense"}}</legend>

    <div class="swe-block">
      <div class="swe-block-head">
        <span class="swe-block-title">{{localize "SWE.Base"}}</span>
      </div>
      <div class="swe-armor-grid">
        {{#if isArmor}}
        <label>{{localize "SWE.ArmCategory"}}
          <select name="base.category">
            {{#each categoryOptions}}
            <option value="{{this.value}}" {{#if (sweEq this.value ../data.category)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>{{localize "SWE.ArmGroup"}}
          <select name="base.group">
            {{#each groupOptions}}
            <option value="{{this.value}}" {{#if (sweEq this.value ../data.group)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>{{localize "SWE.ArmAcBonus"}}
          <input type="number" name="base.acBonus" value="{{data.acBonus}}" min="0" max="20" step="1" />
        </label>
        <label>{{localize "SWE.ArmDexCap"}}
          <input type="number" name="base.dexCap" value="{{data.dexCap}}" min="0" max="10" step="1" />
        </label>
        <label>{{localize "SWE.ArmCheckPenalty"}}
          <input type="number" name="base.checkPenalty" value="{{data.checkPenalty}}" min="-10" max="0" step="1" />
        </label>
        <label>{{localize "SWE.ArmSpeedPenalty"}}
          <input type="number" name="base.speedPenalty" value="{{data.speedPenalty}}" min="-30" max="0" step="5" />
        </label>
        <label title="{{localize 'SWE.ArmStrengthHint'}}">{{localize "SWE.ArmStrength"}}
          <input type="number" name="base.strength" value="{{data.strength}}" min="-5" max="10" step="1" placeholder="&mdash;" />
        </label>
        {{else}}
        <label>{{localize "SWE.ArmAcBonus"}}
          <input type="number" name="base.acBonus" value="{{data.acBonus}}" min="0" max="10" step="1" />
        </label>
        <label>{{localize "SWE.ShHardness"}}
          <input type="number" name="base.hardness" value="{{data.hardness}}" min="0" max="50" step="1" />
        </label>
        <label>{{localize "SWE.ShHpMax"}}
          <input type="number" name="base.hpMax" value="{{data.hpMax}}" min="0" max="999" step="1" />
        </label>
        <label>{{localize "SWE.ArmSpeedPenalty"}}
          <input type="number" name="base.speedPenalty" value="{{data.speedPenalty}}" min="-30" max="0" step="5" />
        </label>
        {{/if}}
      </div>
    </div>

    <div class="swe-block swe-block-def">
      <div class="swe-block-head">
        <span class="swe-block-title swe-title-def"><i class="fa-solid fa-shield"></i> {{localize "SWE.ArmDefensesHead"}}</span>
      </div>
      {{#each defensesIndexed}}
      <div class="swe-row">
        <select name="defs.{{this.index}}.kind" class="swe-cat">
          {{#each ../defKindOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../kind)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <select name="defs.{{this.index}}.type">
          {{#each this.typeOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{#unless this.isImmunity}}
        <select name="defs.{{this.index}}.scale" class="swe-cat">
          {{#each ../scaleOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../scale)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{#if (sweEq this.scale 'fixed')}}
        <input type="number" name="defs.{{this.index}}.value" value="{{this.value}}" min="1" max="99" step="1" class="swe-narrow" />
        {{/if}}
        {{/unless}}
        <select name="defs.{{this.index}}.except" class="swe-cat" title="{{localize 'SWE.ArmExceptHint'}}">
          {{#each this.exceptOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../except)}}selected{{/if}}>{{#if this.value}}{{localize "SWE.ArmExcept"}} {{/if}}{{this.label}}</option>
          {{/each}}
        </select>
        {{#if ../isShield}}
        <label class="swe-pickbox" title="{{localize 'SWE.ArmRaisedHint'}}">
          <input type="checkbox" name="defs.{{this.index}}.raised" {{#if this.raised}}checked{{/if}} />
          {{localize "SWE.ArmRaised"}}
        </label>
        {{/if}}
        <input type="text" name="defs.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" class="swe-src" />
        <a class="swe-rowdel" data-action="sweRemoveDefense" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/each}}
      <button type="button" data-action="sweAddDefense" class="swe-ghostbtn swe-ghost-def"><i class="fa-solid fa-plus"></i> {{localize "SWE.ArmAddDefense"}}</button>
    </div>

    <div class="swe-block swe-block-mods">
      <div class="swe-block-head">
        <span class="swe-block-title swe-title-mods"><i class="fa-solid fa-arrow-up-right-dots"></i> {{localize "SWE.ArmModsHead"}}</span>
      </div>
      {{#each modsIndexed}}
      <div class="swe-row">
        <select name="mods.{{this.index}}.target">
          {{#each ../targetOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../target)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <select name="mods.{{this.index}}.type" class="swe-cat" title="{{localize 'SWE.BonusTypeHint'}}">
          {{#each ../bonusTypeOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../type)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <input type="number" name="mods.{{this.index}}.value" value="{{this.value}}" min="-99" max="99" step="1" class="swe-narrow" title="{{localize 'SWE.ArmModValueHint'}}" />
        {{#if this.againstApplies}}
        <select name="mods.{{this.index}}.against" class="swe-cat">
          {{#each ../againstOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../against)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{/if}}
        {{#if ../isShield}}
        <label class="swe-pickbox" title="{{localize 'SWE.ArmRaisedHint'}}">
          <input type="checkbox" name="mods.{{this.index}}.raised" {{#if this.raised}}checked{{/if}} />
          {{localize "SWE.ArmRaised"}}
        </label>
        {{/if}}
        <input type="text" name="mods.{{this.index}}.src" value="{{this.src}}" placeholder="{{localize 'SWE.SourcePh'}}" class="swe-src" />
        <a class="swe-rowdel" data-action="sweRemoveMod" data-index="{{this.index}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{#if this.itemOnAc}}
      <p class="swe-hint swe-row-hint"><i class="fa-solid fa-circle-info"></i> {{localize "SWE.ArmItemStackHint"}}</p>
      {{/if}}
      {{#if this.circOnShieldAc}}
      <p class="swe-hint swe-row-hint"><i class="fa-solid fa-circle-info"></i> {{localize "SWE.ShCircHint"}}</p>
      {{/if}}
      {{/each}}
      <button type="button" data-action="sweAddMod" class="swe-ghostbtn swe-ghost-mods"><i class="fa-solid fa-plus"></i> {{localize "SWE.ArmAddMod"}}</button>
    </div>

    <div class="swe-previewbar">
      <span class="swe-previewbar-label">{{localize "SWE.Preview"}}:</span>
      {{#each preview}}<span class="swe-armor-chip">{{this}}</span>{{/each}}
    </div>
    {{#each notes}}
    <p class="swe-hint"><i class="fa-solid fa-circle-info"></i> {{this}}</p>
    {{/each}}
    <p class="swe-hint"><i class="fa-solid fa-circle-info"></i> {{#if isArmor}}{{localize "SWE.ArmInvestHint"}}{{else}}{{localize "SWE.ShEquipHint"}}{{/if}}</p>
  </fieldset>

  <fieldset class="swe-section swe-tabpanel{{#if (sweEq activeTab 'runes')}} active{{/if}}">
    <legend><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "SWE.Runes"}}</legend>
    {{#if abp}}
    <p class="swe-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SWE.ArmABPWarn"}}</p>
    {{/if}}

    {{#if isArmor}}
    <div class="swe-grid2">
      <label>{{localize "SWE.Potency"}}
        <select name="runes.potency">
          {{#each potencyOptions}}
          <option value="{{this}}" {{#if (sweEq this ../data.runes.potency)}}selected{{/if}}>{{#if this}}+{{this}}{{else}}&mdash;{{/if}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "SWE.ArmResilient"}}
        <select name="runes.resilient">
          {{#each resilientOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../data.runes.resilient)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <p class="swe-hint"><i class="fa-solid fa-circle-info"></i> {{localize "SWE.ArmPotencyHint"}}</p>

    <div class="swe-runes-meta">
      <span class="swe-block-title">{{localize "SWE.PropertyRunes"}}</span>
      <span class="{{#if overLimit}}swe-meta-over{{else}}swe-meta-ok{{/if}}">{{propCount}}/{{slots}}</span>
      {{#if runesGp}}<span class="swe-meta-gp">{{runesGp}} gp</span>{{/if}}
    </div>

    {{#each runesResolved}}
    <div class="swe-rune-card{{#if this.over}} over{{/if}}{{#if this.selected}} open{{/if}}">
      <div class="swe-rune-row">
        <span class="swe-rune-name">{{this.label}}</span>
        {{#if this.level}}<span class="swe-badge-lv">{{localize "SWE.LevelShort"}} {{this.level}}</span>{{/if}}
        {{#if this.over}}
        <span class="swe-rune-over">{{localize "SWE.OverSlot"}}</span>
        {{else}}
        {{#if this.price}}<span class="swe-rune-price">{{this.price}} gp</span>{{/if}}
        {{/if}}
        <span class="swe-rune-acts">
          <a data-action="sweShowRune" data-slug="{{this.slug}}" title="{{localize 'SWE.ShowRune'}}"><i class="fa-solid fa-circle-info"></i></a>
          <a data-action="sweRemoveRune" data-slug="{{this.slug}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
        </span>
      </div>
      {{#if this.selected}}
      <div class="swe-rune-desc">
        {{#if this.descHTML}}{{{this.descHTML}}}{{else}}<p class="swe-muted">{{localize "SWE.NoRuneDesc"}}</p>{{/if}}
      </div>
      {{/if}}
    </div>
    {{/each}}

    <div class="swe-row">
      <input type="text" name="runeToAdd" list="{{dlRune}}" class="swe-search" placeholder="{{localize 'SWE.RuneSearchPh'}}" autocomplete="off" spellcheck="false" />
      <button type="button" data-action="sweAddRune"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddRune"}}</button>
    </div>
    <p class="swe-hint"><i class="fa-solid fa-circle-info"></i> {{localize "SWE.ArmRunesInertHint"}}</p>

    {{#if overLimit}}
    <p class="swe-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SWE.OverLimit"}} ({{propCount}}/{{slots}})</p>
    <label class="swe-check">
      <input type="checkbox" name="freeMode" {{#if data.freeMode}}checked{{/if}} />
      {{localize "SWE.FreeMode"}}
    </label>
    {{/if}}
    {{else}}
    <div class="swe-grid2">
      <label>{{localize "SWE.ShReinforcing"}}
        <select name="runes.reinforcing">
          {{#each reinforcingOptions}}
          <option value="{{this.value}}" {{#if (sweEq this.value ../data.reinforcing)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <p class="swe-hint"><i class="fa-solid fa-circle-info"></i> {{localize "SWE.ShReinforcingHint"}}</p>
    {{/if}}
  </fieldset>

  <fieldset class="swe-section swe-tabpanel{{#if (sweEq activeTab 'traits')}} active{{/if}}">
    <legend><i class="fa-solid fa-tags"></i> {{localize "SWE.Traits"}}</legend>
    <div class="swe-chiplist">
      {{#each traitsResolved}}
      <span class="swe-chip">{{this.label}}
        <a data-action="sweRemoveTrait" data-slug="{{this.slug}}" title="{{localize 'SWE.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
      </span>
      {{/each}}
    </div>
    <div class="swe-row">
      <input type="text" name="traitToAdd" list="{{dlTrait}}" class="swe-search" placeholder="{{localize 'SWE.TraitSearchPh'}}" autocomplete="off" spellcheck="false" />
      <button type="button" data-action="sweAddTrait"><i class="fa-solid fa-plus"></i> {{localize "SWE.AddTrait"}}</button>
    </div>
    {{#if freqTraits.length}}
    <div class="swe-freq">
      <span class="swe-freq-label">{{localize "SWE.Frequent"}}</span>
      <div class="swe-chiplist">
        {{#each freqTraits}}
        <a class="swe-ghostchip" data-action="sweQuickTrait" data-slug="{{this.value}}"><i class="fa-solid fa-plus"></i> {{this.label}}</a>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </fieldset>

  {{#each datalists}}
  <datalist id="{{this.id}}">
    {{#each this.options}}<option value="{{this.label}}"></option>{{/each}}
  </datalist>
  {{/each}}

  <footer class="swe-footer">
    <button type="button" data-action="sweRevert"><i class="fa-solid fa-rotate-left"></i> {{localize "SWE.Revert"}}</button>
    <button type="submit" class="swe-save"><i class="fa-solid fa-floppy-disk"></i> {{localize "SWE.Save"}}</button>
  </footer>

</div>
